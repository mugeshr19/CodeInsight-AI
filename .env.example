# Backend Environment Variables
# Copy this to application.properties and fill in your values

# MongoDB Configuration
spring.data.mongodb.uri=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
spring.data.mongodb.database=codeinsight

# JWT Configuration
jwt.secret=your-256-bit-secret-key-here-make-it-long-and-secure
jwt.expiration=86400000

# Groq API Configuration (xAI)
groq.api.key=your-groq-api-key-here
groq.api.url=https://api.x.ai/v1/chat/completions
groq.model=grok-beta

# CORS Configuration
cors.allowed.origins=http://localhost:5173,http://localhost:3000

# Server Configuration
server.port=8080

# Logging
logging.level.com.codeinsight=INFO

# Frontend Environment Variables
# Create .env file in frontend directory

VITE_API_URL=http://localhost:8080/api
